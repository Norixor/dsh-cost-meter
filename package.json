{
  "name": "@norixor/dsh-cost-meter",
  "version": "0.7.0",
  "description": "Per-session and per-model cost meter for DeepSeek Harness: preset prices for 60+ models, peak pricing, context-length tiers, budget traffic light, display styles, a sidebar statistics page with charts, latency analysis and experimental image / speech metering.",
  "license": "MIT",
  "author": "Norixor",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cost",
    "usage",
    "billing",
    "budget",
    "token",
    "pricing"
  ],
  "homepage": "https://github.com/Norixor/dsh-cost-meter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Norixor/dsh-cost-meter.git"
  },
  "bugs": {
    "url": "https://github.com/Norixor/dsh-cost-meter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "route-security.js",
    "presets.js",
    "pricing.js",
    "daily.js",
    "timing.js",
    "calllog.js",
    "media.js",
    "history.js",
    "prefs.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs --check && node --test test/*.test.mjs"
  }
}
